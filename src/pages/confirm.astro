---
export const prerender = false;

import type { EmailOtpType } from "@supabase/supabase-js";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getAuthUser } from "../lib/auth";
import { createSupabaseServerClient } from "../lib/supabase";
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from "astro:env/server";

const code = Astro.url.searchParams.get("code");
const tokenHash = Astro.url.searchParams.get("token_hash");
const type = Astro.url.searchParams.get("type") as EmailOtpType | null;

if (code && type === "recovery") {
  return Astro.redirect(`/reset-password${Astro.url.search}`);
}

if (tokenHash && type === "recovery") {
  return Astro.redirect(`/reset-password${Astro.url.search}`);
}

if (code) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) {
    return Astro.redirect("/confirm?error=" + encodeURIComponent(error.message));
  }
  return Astro.redirect("/confirm");
}

if (tokenHash && type) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.verifyOtp({ type, token_hash: tokenHash });
  if (error) {
    return Astro.redirect("/confirm?error=" + encodeURIComponent(error.message));
  }
  return Astro.redirect("/confirm");
}

const error = Astro.url.searchParams.get("error");
const { user } = await getAuthUser(Astro.request, Astro.cookies);
---

<Layout title="Email confirmed">
  <div
    id="confirm-auth"
    data-supabase-url={SUPABASE_URL}
    data-supabase-key={SUPABASE_PUBLISHABLE_KEY}
    hidden
  ></div>

  <div class="app-shell">
    <Navbar>
      {
        user ? (
          <a href="/dashboard" class="btn btn-ghost btn-sm">Dashboard</a>
        ) : (
          <a href="/signin" class="btn btn-ghost btn-sm">Sign in</a>
        )
      }
    </Navbar>
    <div class="auth-shell">
      <div class="auth-card">
        {
          error ? (
            <>
              <h1>Confirmation failed</h1>
              <p class="sub">
                The link may have expired. Try signing up again or request a new confirmation email.
              </p>
              <a href="/signup" class="btn btn-primary btn-block">Back to sign up</a>
              <p class="switch-line">
                Already confirmed? <a href="/signin">Sign in</a>
              </p>
            </>
          ) : (
            <>
              <h1>Email confirmed</h1>
              <p class="sub">
                Your account is verified. You're all set to start tracking assignments.
              </p>
              {
                user ? (
                  <a href="/dashboard" class="btn btn-primary btn-block">Go to dashboard</a>
                ) : (
                  <a href="/signin" class="btn btn-primary btn-block">Sign in</a>
                )
              }
            </>
          )
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  import { handleConfirmAuthHash } from "../scripts/confirm-auth.client";
  handleConfirmAuthHash();
</script>
