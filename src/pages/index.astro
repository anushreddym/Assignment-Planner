---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import DashboardPreview from "../components/DashboardPreview.astro";
import { getAuthUser } from "../lib/auth";
import { readAuthIntent } from "../lib/auth-intent";
import { authHandlerRedirect } from "../lib/auth-routes";

const { user } = await getAuthUser(Astro.request, Astro.cookies);

const authCode = Astro.url.searchParams.get("code");
const tokenHash = Astro.url.searchParams.get("token_hash");
if (authCode || tokenHash) {
  return Astro.redirect(authHandlerRedirect(Astro.url, readAuthIntent(Astro.cookies)));
}

if (user) return Astro.redirect("/dashboard");
---

<Layout>
  <div class="app-shell">
    <Navbar>
      {
        user ? (
          <a href="/dashboard" class="btn btn-primary btn-sm">Dashboard</a>
        ) : (
          <>
            <a href="/signin" class="btn btn-ghost btn-sm">Sign in</a>
            <a href="/signup" class="btn btn-primary btn-sm">Get started</a>
          </>
        )
      }
    </Navbar>

    <main class="landing-main">
      <section class="landing-hero-grid">
        <div class="landing-hero">
          <p class="landing-eyebrow">Simple · private · yours</p>
          <h1>Track assignments without the clutter.</h1>
          <p class="landing-lead">
            Organize assignments by subject, see what's due this week, and mark things done as you go.
            Built for students who want a clean list, not another bloated planner.
          </p>
          <div class="landing-cta">
            {
              user ? (
                <a href="/dashboard" class="btn btn-primary">Open dashboard</a>
              ) : (
                <>
                  <a href="/signup" class="btn btn-primary">Create free account</a>
                  <a href="/signin" class="btn btn-ghost">Sign in</a>
                </>
              )
            }
          </div>
        </div>

        <DashboardPreview />
      </section>

      <section class="landing-features">
        <article class="landing-card">
          <h2>By subject</h2>
          <p>Filter Math, Science, English, or any custom subject with color-coded tags.</p>
        </article>
        <article class="landing-card">
          <h2>Due dates that make sense</h2>
          <p>Assignments group into Today, This week, and Later so you know what to tackle first.</p>
        </article>
        <article class="landing-card">
          <h2>Your account, your data</h2>
          <p>Sign in from anywhere. Your assignments sync to your account. Nothing is shared publicly.</p>
        </article>
      </section>

      <section class="landing-bottom-cta">
        <h2>Ready to get organized?</h2>
        <p>Free to use. Your assignments stay tied to your account.</p>
        <div class="landing-cta">
          {
            user ? (
              <a href="/dashboard" class="btn btn-primary">Go to dashboard</a>
            ) : (
              <>
                <a href="/signup" class="btn btn-primary">Create free account</a>
                <a href="/signin" class="btn btn-ghost">Sign in</a>
              </>
            )
          }
        </div>
      </section>
    </main>
  </div>
</Layout>

<script is:inline>
  if (
    window.location.hash &&
    (window.location.hash.includes("access_token") ||
      window.location.hash.includes("error"))
  ) {
    const params = new URLSearchParams(window.location.hash.slice(1));
    const path = params.get("type") === "recovery" ? "/reset-password" : "/confirm";
    window.location.replace(path + window.location.hash);
  }
</script>
