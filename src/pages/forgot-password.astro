---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getAuthUser } from "../lib/auth";

const { user } = await getAuthUser(Astro.request, Astro.cookies);
if (user) return Astro.redirect("/dashboard");

const sent = Astro.url.searchParams.has("sent");
const email = Astro.url.searchParams.get("email");
---

<Layout title="Forgot password">
  <div class="app-shell">
    <Navbar>
      <a href="/signin" class="btn btn-ghost btn-sm">Sign in</a>
    </Navbar>
    <div class="auth-shell">
      <div class="auth-card">
        {
          sent ? (
            <>
              <h1>Check your email</h1>
              <p class="sub">
                {email
                  ? `If an account exists for ${email}, we sent a password reset link.`
                  : "If an account exists for that email, we sent a password reset link."}
              </p>
              <a href="/signin" class="btn btn-primary btn-block">Back to sign in</a>
              <p class="switch-line">
                Did not get it? <a href="/forgot-password">Try again</a>
              </p>
            </>
          ) : (
            <>
              <h1>Forgot password</h1>
              <p class="sub">Enter your email and we will send you a reset link.</p>
              <form action="/api/auth/forgot-password" method="post">
                <div class="field">
                  <label for="email">Email</label>
                  <input
                    class="input"
                    type="email"
                    id="email"
                    name="email"
                    placeholder="you@school.edu"
                    autocomplete="email"
                    required
                  />
                </div>
                <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
              </form>
              <p class="switch-line">
                Remember your password? <a href="/signin">Sign in</a>
              </p>
            </>
          )
        }
      </div>
    </div>
  </div>
</Layout>
