---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

const email = Astro.url.searchParams.get("email");
---

<Layout title="Check your email">
  <div class="app-shell">
    <Navbar>
      <a href="/signin" class="btn btn-ghost btn-sm">Sign in</a>
    </Navbar>
    <div class="auth-shell">
      <div class="auth-card">
        <h1>Check your email</h1>
        <p class="sub">
          {
            email
              ? `We sent a confirmation link to ${email}. Open it to verify your account.`
              : "We sent a confirmation link to your email. Open it to verify your account."
          }
        </p>
        <a href="/signin" class="btn btn-primary btn-block">Back to sign in</a>
        <p class="switch-line">
          Wrong email? <a href="/signup">Try again</a>
        </p>
      </div>
    </div>
  </div>
</Layout>
