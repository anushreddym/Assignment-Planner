---
export const prerender = false;

import type { EmailOtpType } from "@supabase/supabase-js";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getAuthUser } from "../lib/auth";
import { createSupabaseServerClient } from "../lib/supabase";
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from "astro:env/server";

const code = Astro.url.searchParams.get("code");
const tokenHash = Astro.url.searchParams.get("token_hash");
const type = Astro.url.searchParams.get("type") as EmailOtpType | null;

if (code) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) {
    return Astro.redirect("/reset-password?error=" + encodeURIComponent(error.message));
  }
  return Astro.redirect("/reset-password");
}

if (tokenHash && type === "recovery") {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.verifyOtp({ type, token_hash: tokenHash });
  if (error) {
    return Astro.redirect("/reset-password?error=" + encodeURIComponent(error.message));
  }
  return Astro.redirect("/reset-password");
}

const error = Astro.url.searchParams.get("error");
const { user } = await getAuthUser(Astro.request, Astro.cookies);
---

<Layout title="Reset password">
  <div
    id="reset-auth"
    data-supabase-url={SUPABASE_URL}
    data-supabase-key={SUPABASE_PUBLISHABLE_KEY}
    hidden
  ></div>

  <div class="app-shell">
    <Navbar>
      <a href="/signin" class="btn btn-ghost btn-sm">Sign in</a>
    </Navbar>
    <div class="auth-shell">
      <div class="auth-card">
        {
          error ? (
            <>
              <h1>Reset failed</h1>
              <p class="sub">{error}</p>
              <a href="/forgot-password" class="btn btn-primary btn-block">Request a new link</a>
              <p class="switch-line">
                <a href="/signin">Back to sign in</a>
              </p>
            </>
          ) : user ? (
            <>
              <h1>Choose a new password</h1>
              <p class="sub">Enter a new password for your account.</p>
              <form action="/api/auth/reset-password" method="post">
                <div class="field">
                  <label for="password">New password</label>
                  <div class="password-wrapper">
                    <input
                      class="input"
                      type="password"
                      id="password"
                      name="password"
                      placeholder="••••••••"
                      autocomplete="new-password"
                      required
                    />
                    <button type="button" class="toggle-password" aria-label="Show password">
                      <svg
                        class="icon-eye"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                      <svg
                        class="icon-eye-off"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path
                          d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.8 21.8 0 0 1 5.06-6.06M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.8 21.8 0 0 1-2.16 3.19M14.12 14.12a3 3 0 1 1-4.24-4.24"
                        ></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="field">
                  <label for="confirm-password">Confirm new password</label>
                  <div class="password-wrapper">
                    <input
                      class="input"
                      type="password"
                      id="confirm-password"
                      name="confirm-password"
                      placeholder="Re-enter your password"
                      autocomplete="new-password"
                      required
                    />
                    <button type="button" class="toggle-password" aria-label="Show password">
                      <svg
                        class="icon-eye"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                      <svg
                        class="icon-eye-off"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path
                          d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.8 21.8 0 0 1 5.06-6.06M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.8 21.8 0 0 1-2.16 3.19M14.12 14.12a3 3 0 1 1-4.24-4.24"
                        ></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                      </svg>
                    </button>
                  </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Update password</button>
              </form>
            </>
          ) : (
            <>
              <h1>Reset link required</h1>
              <p class="sub">Open the password reset link from your email to continue.</p>
              <a href="/forgot-password" class="btn btn-primary btn-block">Request a reset link</a>
              <p class="switch-line">
                <a href="/signin">Back to sign in</a>
              </p>
            </>
          )
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  import { handleResetAuthHash } from "../scripts/reset-auth.client";
  handleResetAuthHash();
</script>
