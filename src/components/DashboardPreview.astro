---
---

<div class="dashboard-preview" aria-hidden="true">
  <div class="dashboard-preview-chrome">
    <span class="dashboard-preview-dot"></span>
    <span class="dashboard-preview-dot"></span>
    <span class="dashboard-preview-dot"></span>
  </div>

  <div class="dashboard-preview-body">
    <div class="dashboard-preview-topbar">
      <span class="dashboard-preview-brand">Assignment Planner</span>
      <span class="dashboard-preview-avatar">JD</span>
    </div>

    <div class="dashboard-preview-head">
      <p class="dashboard-preview-date">Wednesday, August 26, 2026</p>
      <p class="dashboard-preview-greeting">Welcome back, Jordan</p>
      <p class="dashboard-preview-sub">You have 4 open tasks across 4 subjects.</p>
    </div>

    <div class="dashboard-preview-tabs">
      <span class="dashboard-preview-tab active">All</span>
      <span class="dashboard-preview-tab" style="--tab-color: var(--subject-blue);">
        <span class="swatch"></span> Math
      </span>
      <span class="dashboard-preview-tab" style="--tab-color: var(--subject-green);">
        <span class="swatch"></span> Science
      </span>
      <span class="dashboard-preview-tab" style="--tab-color: var(--subject-violet);">
        <span class="swatch"></span> English
      </span>
    </div>

    <p class="dashboard-preview-group-title">Today</p>

    <div
      class="dashboard-preview-task"
      style="--subject-color: var(--subject-blue);"
    >
      <span class="dashboard-preview-check"></span>
      <div class="dashboard-preview-task-body">
        <span class="dashboard-preview-subject">Math</span>
        <p class="dashboard-preview-title">Finish worksheet 4.3</p>
        <p class="dashboard-preview-desc">Problems 1-20, show work for the discriminant section.</p>
      </div>
      <span class="dashboard-preview-due urgent">
        <span class="day">Thu</span>
        <span class="date">Aug 28</span>
      </span>
    </div>

    <div
      class="dashboard-preview-task"
      style="--subject-color: var(--subject-green);"
    >
      <span class="dashboard-preview-check"></span>
      <div class="dashboard-preview-task-body">
        <span class="dashboard-preview-subject">Science</span>
        <p class="dashboard-preview-title">Lab report: osmosis</p>
        <p class="dashboard-preview-desc">Write up results from Tuesday's lab.</p>
      </div>
      <span class="dashboard-preview-due">
        <span class="day">Fri</span>
        <span class="date">Aug 29</span>
      </span>
    </div>

    <p class="dashboard-preview-group-title">This week</p>

    <div
      class="dashboard-preview-task completed"
      style="--subject-color: var(--subject-violet);"
    >
      <span class="dashboard-preview-check checked"></span>
      <div class="dashboard-preview-task-body">
        <span class="dashboard-preview-subject">English</span>
        <p class="dashboard-preview-title">Read chapter 5</p>
        <p class="dashboard-preview-desc">Take notes on the main themes.</p>
      </div>
      <span class="dashboard-preview-due">
        <span class="day">Mon</span>
        <span class="date">Aug 25</span>
      </span>
    </div>
  </div>
</div>
